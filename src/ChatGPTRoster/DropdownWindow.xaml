<Window x:Class="ChatGPTRoster.DropdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roster Companion accounts"
        Width="428"
        SizeToContent="Height"
        MaxHeight="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Border x:Name="Shell"
            Margin="10"
            TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.20" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <Grid Margin="12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HeaderAccountName"
                           Margin="4,0,8,0"
                           Text="{Binding SelectorLabel}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <Border x:Name="SearchPanel"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Visibility="Collapsed"
                        Height="38"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 CaretBrush="{DynamicResource PrimaryTextBrush}"
                                 FontSize="13.5"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Search accounts" />
                        <Button Grid.Column="2"
                                Click="ClearSearch_Click"
                                Style="{StaticResource IconButtonStyle}"
                                Width="28"
                                Height="28"
                                ToolTip="Clear search">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </Grid>
                </Border>

                <Button x:Name="SearchButton"
                        Grid.Column="1"
                        Click="SearchButton_Click"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Search accounts">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                </Button>

                <Button x:Name="GearButton"
                        Grid.Column="2"
                        Margin="2,0,0,0"
                        Click="GearButton_Click"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Roster Companion settings">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    <Button.ContextMenu>
                        <ContextMenu Opened="SettingsMenu_Opened"
                                     MinWidth="232"
                                     Placement="Bottom"
                                     HorizontalOffset="-188"
                                     VerticalOffset="4">
                            <MenuItem x:Name="StartWithWindowsMenuItem"
                                      Header="Start with Windows"
                                      IsCheckable="True"
                                      Click="StartWithWindows_Click" />
                            <MenuItem Header="About Roster Companion" Click="About_Click" />
                            <Separator />
                            <MenuItem Header="Exit Roster Companion" Click="Exit_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="AccountsScroller"
                              MaxHeight="480"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding AccountsView}" Margin="8,7">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2"
                                        Padding="13,12"
                                        Background="Transparent"
                                        CornerRadius="9">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="7" Height="7" Margin="0,7,0,0" VerticalAlignment="Top">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}" />
                                                    <Setter Property="StrokeThickness" Value="1" />
                                                    <Setter Property="Fill" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" Margin="2,0,10,0">
                                            <WrapPanel>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Margin="0,0,7,0"
                                                           FontSize="14.5"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <Border Padding="7,2"
                                                        Margin="0,1,0,1"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                    <TextBlock Text="{Binding Plan}" FontSize="11.5" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding Email}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Email}" />
                                            <TextBlock Margin="0,7,0,0"
                                                       Text="{Binding CompactUsageText}"
                                                       FontSize="13" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding WeeklyResetCompactText}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="12.5" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding UsageFreshnessText}"
                                                       Foreground="#E9A23B"
                                                       FontSize="12"
                                                       Visibility="{Binding IsUsageStale, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="Active"
                                                       Margin="8,3,4,0"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button Command="{Binding SwitchAccountCommand}"
                                                    Style="{StaticResource TextButtonStyle}"
                                                    MinWidth="118"
                                                    FontSize="13"
                                                    Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <TextBlock Text="Change Account" />
                                            </Button>
                                            <Button Margin="0,8,0,0"
                                                    Click="AccountMenuButton_Click"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    ToolTip="Account options">
                                                <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                                <Button.ContextMenu>
                                                    <ContextMenu MinWidth="224"
                                                                 Placement="Bottom"
                                                                 HorizontalOffset="-184"
                                                                 VerticalOffset="4"
                                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Set alias" Command="{Binding RenameAliasCommand}" />
                                                        <MenuItem Header="Remove account"
                                                                  Style="{StaticResource DangerMenuItemStyle}"
                                                                  Command="{Binding RemoveAccountCommand}"
                                                                  ToolTip="Change to another account before removing the active account" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Margin="28,30"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasAccounts, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="No accounts added yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,5,0,0"
                               Text="Add the account currently used by ChatGPT."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextAlignment="Center" />
                </StackPanel>

                <TextBlock Margin="28,34"
                           Text="No matching accounts"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasAccounts}" Value="True" />
                                        <Condition Binding="{Binding HasSearchResults}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding AddAccountCommand}" Style="{StaticResource TextButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AddAccountGlyph}" Margin="0,0,6,0" FontSize="17" />
                            <TextBlock Text="{Binding AddAccountLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1"
                               Margin="8,0"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    <Button Grid.Column="2"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource TextButtonStyle}"
                            ToolTip="Refresh usage">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
