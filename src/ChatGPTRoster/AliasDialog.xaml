<Window x:Class="ChatGPTRoster.AliasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set alias"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Padding="24"
            TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <StackPanel>
            <TextBlock Text="Set account alias" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,14"
                       Text="Use a short name such as Personal or Work. Leave it blank to use the email address."
                       TextWrapping="Wrap"
                       FontSize="13.5"
                       LineHeight="19"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <Border Height="42"
                    Margin="0,0,0,18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBox x:Name="AliasTextBox"
                         MaxLength="80"
                         Padding="10,7"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         FontSize="13.5"
                         CaretBrush="{DynamicResource PrimaryTextBrush}" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Margin="0,0,8,0"
                        Style="{StaticResource TextButtonStyle}"
                        Click="Cancel_Click" />
                <Button Content="Save alias"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
